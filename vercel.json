{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --loglevel error",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/api"
    }
  }
}
